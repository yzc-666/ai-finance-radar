{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-finance-radar.local/config/company.schema.json",
  "title": "AI x Finance Radar company dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "companies"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated_at": {"type": "string", "format": "date-time"},
    "companies": {
      "type": "array",
      "minItems": 30,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/company"}
    }
  },
  "$defs": {
    "sector": {
      "enum": [
        "Research & Data",
        "Trading & Wealth",
        "Banking Operations",
        "Credit & Underwriting",
        "Fraud & Identity",
        "AML/KYC & Compliance",
        "Insurance",
        "Customer Operations",
        "Financial Infrastructure"
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "note", "url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1, "maxLength": 300},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "publisher", "tier", "retrieved_at", "note"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "publisher": {"type": "string", "minLength": 1},
        "tier": {"const": "primary"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "country",
        "hq",
        "founded_year",
        "sectors",
        "one_liner",
        "homepage",
        "products",
        "sources",
        "verification_status",
        "last_verified_at"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "country": {"enum": ["CN", "US"]},
        "hq": {"type": "string", "minLength": 1},
        "founded_year": {"type": ["integer", "null"], "minimum": 1800, "maximum": 2026},
        "sectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sector"}
        },
        "one_liner": {"type": "string", "minLength": 1, "maxLength": 500},
        "homepage": {"type": "string", "format": "uri", "pattern": "^https://"},
        "products": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/product"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "verification_status": {"const": "verified"},
        "last_verified_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
